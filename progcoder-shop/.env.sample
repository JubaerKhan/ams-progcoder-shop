MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=7402
MINIO_UI_PORT=7403

############################################
#            IDENTITY / SECURITY
############################################
# Keycloak
