############################################
#                DATABASE
############################################
# Postgres (Catalog_Service + Keycloak's own schema)
POSTGRES_IMAGE_NAME=postgres:14.7
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789Aa
POSTGRES_PORT=7301
POSTGRES_MULTIPLE_DATABASES=keycloak_db,Catalog_Service

############################################
#          STORAGE / OBJECT STORE
