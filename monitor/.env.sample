# Host/port the monitor listens on. The otel-collector reaches this via
# host.docker.internal (see config/otel-collector/otel-collector-config.yaml),
# so PORT here must match the port used in that exporter's endpoint.
MONITOR_HOST=0.0.0.0
MONITOR_PORT=7787

# Where issue records are stored, as {MONITOR_DATA_DIR}/{WARN|ERROR}/{fingerprint}.json
MONITOR_DATA_DIR=./data

# Cap on stored occurrence timestamps per issue (oldest are dropped once exceeded;
# the "count" total is never truncated, only the occurrence list).
MONITOR_MAX_OCCURRENCES=100

# If set, an HTTP POST is fired here on every new issue and every repeat occurrence.
# Leave blank/unset to disable.
MONITOR_WEBHOOK_URL=

# If set, every request to /mcp and /v1/logs must send "Authorization: Bearer <this
# value>" or get a 401 (/health stays open). Must match the repo-root .env's
# MONITOR_API_KEY, since that's what the otel-collector sends. Leave unset only for
# localhost-only use - required once this is reachable beyond your own machine.
MONITOR_API_KEY=l-E7ZujxWF9nuUCGNmfh_kpNYTsk49T-EgRrbotEgkI
